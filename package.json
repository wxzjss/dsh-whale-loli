{
  "name": "dsh-whale-loli",
  "version": "0.5.3",
  "description": "鲸鱼娘 Agent 预设（三个）— 极简模式工具面 + 鲸鱼娘·小鱼人设 + 跨会话长期记忆 + 真正生效的 20 轮历史窗口。记忆分「固定记忆」（永久保留）/「滚动摘要」（每轮都记，最多 80 条 FIFO，超限每轮结束自动归档到 archive/<预设名>/）/「最近详细区」/「归档索引」四区，经提示变量注入（persona 为 complete:true，独立 section 会被宿主丢弃）；history-window 用宿主表层替换真的裁掉 20 轮以前的历史，不调 LLM、不切断工具配对，并正确放行 agent/pre-step 的 waterfall。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "persona",
    "memory",
    "whale-loli",
    "deepseek",
    "electron",
    "plugin"
  ],
  "exports": {
    ".": "./src/index.js",
    "./history-window": "./src/history-window.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "listing.json",
    "catalog-entry.yml",
    "README.md",
    "MEMORY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.0 <4.1.0 || >=4.0.5-0 <5.0.0-0",
    "@deepseek-ai/dsh-agent-preset": ">=0.1.7-0 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.0 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-0 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxzjss/dsh-whale-loli.git"
  },
  "homepage": "https://github.com/wxzjss/dsh-whale-loli#readme",
  "bugs": {
    "url": "https://github.com/wxzjss/dsh-whale-loli/issues"
  },
  "dsh-plugin": {
    "category": "identity",
    "displayName": "鲸鱼娘 Agent 预设（原版 + 活人版 + 涩涩版）"
  }
}
